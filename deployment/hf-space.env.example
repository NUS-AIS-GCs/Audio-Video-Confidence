# Stage 2G: public, non-secret Space Variables for the gated UI demo.
# Enter these in Space Settings. This is documentation, not a bootstrap script.
# Dockerfile/main already set the host, port, upload ceiling and prediction gate.
AVAL_ACCESS_MODE=gradio_auth
PORT=7860
AVAL_MODEL_ROOT=/models
AVAL_MAX_UPLOAD_BYTES=52428800
GRADIO_TEMP_DIR=/tmp/gradio
GRADIO_ANALYTICS_ENABLED=False

# Required Space Secrets, intentionally absent from this file:
# AVAL_GRADIO_USERNAME
# AVAL_GRADIO_PASSWORD
# Use a unique, randomly generated password. Missing credentials refuse startup.
# No HF token is needed by the current app; it downloads no models.

# No model mount is required for the MODEL_NOT_READY admission/capture demo.
# Optional artifact mounts/bindings require the reviewed inventory and immutable
# revision described in docs/phase8_stage2g_deployment.md. Do not copy historical
# encoder env examples blindly: layouts and normalization schemas differ.
# There is no prediction-enable variable. Keep readiness gates unchanged.
