# Copy to /etc/avalidate/product.env, root-owned mode 0600. No credentials in Git.
# Required: replace with the actual locally built, inspected, reviewed image ID.
# A mutable tag is deliberately not accepted by the target preflight.
AVAL_PRODUCT_IMAGE=
AVAL_ACCESS_MODE=gradio_auth
GRADIO_ANALYTICS_ENABLED=False
# Optional before the FIRST start with a fresh private directory only:
# AVAL_GRADIO_USERNAME=
# AVAL_GRADIO_PASSWORD=
# If omitted, the supervisor generates a random login in private/login.json.
# Existing login.json takes precedence; no HF token is needed at runtime.
